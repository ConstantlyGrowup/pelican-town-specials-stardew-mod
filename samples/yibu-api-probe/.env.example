# 该文件只用于说明变量，不会被 run.ps1 自动读取，也不要填写真实 Key。
PTS_OPENAI_API_KEY=
PTS_OPENAI_BASE_URL=https://yibuapi.com/v1
PTS_TEXT_MODEL=gpt-5.6-luna
PTS_TEXT_REASONING_EFFORT=high
# 默认图像模型（中转站只分流 gpt-image-2 与 gpt-image-2-max；含 pro 会 500）。
PTS_IMAGE_MODEL=gpt-image-2-max
# 分辨率档位（长边像素）：1K=1280 / 2K=2560 / 4K=3840，默认 2K。
PTS_IMAGE_SIZE_TIER=2K
# 输出比例：1:1（默认）/ 16:9 / 9:16 / 4:3 / 3:4。最终像素由 档位×比例 换算。
PTS_IMAGE_ASPECT_RATIO=1:1
# 默认 url（请求携带 response_format=url，服务端返回图片临时 URL）；
# png/jpeg/webp → 作为 output_format 发送；auto → 不发送 format 参数。
PTS_IMAGE_RESPONSE_FORMAT=url
# 质量，默认 high，gpt-image-2 与 gpt-image-2-max 都支持，每次默认发送。
PTS_IMAGE_QUALITY=high
PTS_CHAT_TIMEOUT_SECONDS=120
PTS_IMAGE_TIMEOUT_SECONDS=600
PTS_MAX_UPLOAD_BYTES=10485760
